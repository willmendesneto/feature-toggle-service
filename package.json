{
  "name": "feature-toggle-service",
  "version": "7.0.1",
  "author": "Will Mendes <willmendesneto@gmail.com>",
  "description": "The simplest solution for feature toggle in Javascript. Simple how it should be.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/willmendesneto/feature-toggle-service.git"
  },
  "homepage": "https://github.com/willmendesneto/feature-toggle-service#readme",
  "bugs": {
    "url": "https://github.com/willmendesneto/feature-toggle-service/issues"
  },
  "sideEffects": false,
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "unpkg": "dist/umd/feature-toggle-service.min.js",
  "jsdelivr": "dist/umd/feature-toggle-service.min.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./dist/umd/feature-toggle-service.js": "./dist/umd/feature-toggle-service.js",
    "./dist/umd/feature-toggle-service.min.js": "./dist/umd/feature-toggle-service.min.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "feature-toggle-service",
    "feature-toggle",
    "feature",
    "toggle",
    "flag"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsdown --config-loader native",
    "test": "vitest --watch=false",
    "test:watch": "vitest --watch",
    "test:smoke": "node scripts/smoke-test.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:types": "tsc --noEmit",
    "lint:package": "publint --strict --pack npm && attw --pack . --profile node16 --exclude-entrypoints ./dist/umd/feature-toggle-service.js ./dist/umd/feature-toggle-service.min.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "size-limit",
    "prepack": "npm run build -s",
    "preversion": "npm run lint -s && npm run format:check -s && npm run lint:types -s && npm run test -s",
    "version": "version-changelog CHANGELOG.md && changelog-verify CHANGELOG.md && git add CHANGELOG.md"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^9.39.5",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "changelog-verify": "^1.1.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "size-limit": "^14.3.0",
    "tsdown": "^0.23.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "version-changelog": "^3.1.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "size-limit": [
    {
      "name": "ESM",
      "path": "dist/index.mjs",
      "import": "{ isOn, set }",
      "limit": "500 B"
    },
    {
      "name": "UMD (minified)",
      "path": "dist/umd/feature-toggle-service.min.js",
      "limit": "600 B"
    }
  ]
}
